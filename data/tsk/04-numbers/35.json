],[65,5,9]]]]],[33,[["it defileth",[[2,18,25],[4,21,1],[4,21,2],[4,21,3],[4,21,4],[4,21,5],[4,21,6],[4,21,7],[4,21,8],[4,21,23],[11,23,26],[11,24,4],[18,106,28],[22,26,21],[25,22,24],[25,22,25],[25,22,26],[25,22,27],[27,4,2],[27,4,3],[32,4,11],[39,23,31],[39,23,32],[39,23,33],[39,23,34],[39,23,35],[41,11,50],[41,11,51]]]]],[34,[["Defile not",[[3,5,3],[2,20,24],[2,20,25],[2,20,26]]],["I dwell",[[18,135,21],[22,57,15],[27,9,3],[46,6,16],[46,6,17],[65,21,3],[65,21,27]]],["dwell among",[[3,5,3],[1,25,8],[1,29,45],[1,29,46],[10,6,13],[18,132,14],[22,8,12]]]]]]}