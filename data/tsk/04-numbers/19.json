{"b":3,"c":19,"v":[[2,[["the ordinance",[[3,31,21],[57,9,10]]],["a red heifer",[[3,19,6],[2,14,6],[22,1,18],[65,1,5]]],["no blemish",[[1,12,5],[2,22,20],[2,22,21],[2,22,22],[2,22,23],[2,22,24],[2,22,25],[38,1,13],[38,1,14],[41,1,35],[57,7,26],[59,1,19],[59,2,22]]],["upon which",[[4,21,3],[8,6,7],[24,1,14],[42,10,17],[42,10,18],[49,2,6],[49,2,7],[49,2,8]]]]],[3,[["without the camp",[[3,5,2],[3,15,36],[2,4,12],[2,4,21],[2,13,45],[2,13,46],[2,16,27],[2,24,14],[57,13,11],[57,13,12],[57,13,13]]]]],[4,[["sprinkle",[[2,4,6],[2,4,17],[2,16,14],[2,16,19],[57,9,13],[57,9,14],[57,12,24],[59,1,2]]]]],[5,[["And one shall burn the heifer in his sight; her skin, and her flesh, and her blood, with her dung, shall he burn:",[[1,29,14],[2,4,11],[2,4,12],[2,4,21],[18,22,14],[22,53,10]]]]],[6,[["And the priest shall take cedar wood, and hyssop, and scarlet, and cast it into the midst of the burning of the heifer.",[[2,14,4],[2,14,6],[2,14,49],[18,51,7],[22,1,18],[57,9,19],[57,9,20],[57,9,21],[57,9,22],[57,9,23]]]]],[7,[["Then the priest shall wash his clothes, and he shall bathe his flesh in water, and afterward he shall come into the camp, and the priest shall be unclean until the even.",[[3,19,8],[3,19,19],[2,11,25],[2,11,40],[2,14,8],[2,14,9],[2,15,5],[2,16,26],[2,16,27],[2,16,28]]]]],[9,[["clean",[[3,19,18],[3,9,13],[46,5,21],[57,7,26],[57,9,13]]],["a water of separation",[[3,19,13],[3,19,20],[3,19,21],[3,6,12],[3,31,23],[3,31,24],[2,15,20],[37,13,1],[46,7,1]]]]],[10,[["wash his",[[3,19,7],[3,19,8],[3,19,19]]],["it shall be",[[3,15,15],[3,15,16],[1,12,49],[44,3,29],[44,3,30],[50,3,11]]]]],[11,[["toucheth the dead",[[3,19,16],[3,5,2],[3,9,6],[3,9,10],[3,31,19],[2,11,31],[2,21,1],[2,21,11],[24,4,14],[36,2,13],[44,5,12],[46,6,17],[48,2,1],[57,9,14]]]]],[12,[["He shall purify",[[3,19,17],[3,19,18],[18,51,7],[25,36,25],[43,15,9],[65,7,14]]],["third day",[[3,31,19],[1,19,11],[1,19,15],[2,7,17],[27,6,2],[45,15,3],[45,15,4]]]]],[13,[["purifieth",[[3,15,30],[2,5,3],[2,5,6],[2,5,17],[2,15,31],[57,2,2],[57,2,3],[57,10,29],[65,21,8],[65,22,11],[65,22,15]]],["the water",[[3,19,9],[3,19,18],[3,8,7]]],["his uncleanness",[[2,7,20],[2,22,3],[19,14,32],[42,8,24]]]]],[15,[["And every open vessel, which hath no covering bound upon it, is unclean.",[[3,31,20],[2,11,32],[2,14,36]]]]],[16,[["toucheth",[[3,19,11],[3,31,19]]],["a bone",[[25,39,11],[25,39,12],[25,39,13],[25,39,14],[25,39,15],[25,39,16]]],["a grave",[[39,23,27],[41,11,44]]]]],[17,[["running water shall be put thereto",[[0,26,19],[21,4,15],[42,4,10],[42,4,11],[42,7,38],[65,7,17]]]]],[18,[["And a clean person shall take hyssop, and dip it in the water, and sprinkle it upon the tent, and upon all the vessels, and upon the persons that were there, and upon him that touched a bone, or one slain, or one dead, or a grave:",[[3,19,9],[18,51,7],[25,36,25],[25,36,26],[25,36,27],[42,15,2],[42,15,3],[42,17,17],[42,17,19],[45,1,30],[57,9,14]]]]],[19,[["shall sprinkle",[[48,5,25],[48,5,26],[48,5,27],[55,2,14],[55,3,3],[55,3,4],[55,3,5],[61,1,7],[61,2,1],[61,2,2],[64,1,23],[65,1,5],[65,1,6]]],["on the seventh day he",[[3,19,12],[3,31,19],[0,2,2],[2,14,9]]]]],[20,[["shall not",[[3,19,13],[3,15,30],[0,17,14],[40,16,16],[43,13,39],[43,13,40],[43,13,41],[44,2,4],[44,2,5],[60,3,14],[65,22,11]]]]],[21,[["And it shall be a perpetual statute unto them, that he that sprinkleth the water of separation shall wash his clothes; and he that toucheth the water of separation shall be unclean until even.",[[2,11,25],[2,11,40],[2,16,26],[2,16,27],[2,16,28],[57,7,19],[57,9,10],[57,9,13],[57,9,14],[57,10,4]]]]],[22,[["whatsoever",[[2,7,19],[36,2,13]]],["the soul",[[2,15,5],[39,15,19],[39,15,20],[40,7,21],[40,7,22],[40,7,23]]]]]]}